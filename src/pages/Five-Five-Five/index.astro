---
// 1. IMPORTS
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import GameInput from "../../components/GameInput.astro";
import { gameTopics as envSciTopics } from "../../data/GameEnvSci";
import { gameTopics as geoTopics } from "../../data/GameGeography";
import { gameTopics as natSciTopics } from "../../data/GameNatSci";
import { gameTopics as otherTopics } from "../../data/GameOthers";
import { gameTopics as other2Topics } from "../../data/GameOthers2";
import { gameTopics as musicTopics } from "../../data/GameMusic";
import { gameTopics as wordsTopics } from "../../data/GameWords";
import { getRandomGameSet } from "../../data/GameLogic";

// 2. SERVER-SIDE PRE-REQUISITES
const rawTopics = [...envSciTopics, ...geoTopics, ...natSciTopics, ...otherTopics, ...other2Topics, ...musicTopics, ...wordsTopics];
const scienceTopics = [...envSciTopics, ...natSciTopics];
---

<BaseLayout>
  <Section>
    <div id="game-root"
         data-geo-set={JSON.stringify(geoTopics)}
         data-sci-set={JSON.stringify(scienceTopics)}
         data-music-set={JSON.stringify(musicTopics)}
         data-mix-set={JSON.stringify(rawTopics)}>

      <div id="menu-screen" class="flex flex-col items-center gap-6 max-w-2xl mx-auto py-10">

        <h1 class="text-4xl font-bold text-[#032922] dark:text-[#f5e5d5] mb-2">The 5-5-5 Game!</h1>

        <!-- Announcement banner -->
        <div class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl p-6 text-center">
          <p class="text-lg font-bold text-[#032922] dark:text-[#f5e5d5] mb-2">🏆 New: Leaderboards for Perfect Scores!</p>
          <p class="text-sm text-[#032922] dark:text-[#f5e5d5] leading-relaxed">If you manage to get a perfect 25/25 in any <strong>timed</strong> gamemode you'll get a chance to add your name to the "Perfect Club" leaderboard below.</p>
        </div>

        <div class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl p-6 text-center">
          <p class="text-[#032922] text-xl dark:text-[#f5e5d5] leading-relaxed">
            Welcome to The 5-5-5 Game. Each question has 5 answers, there's 5 rounds, and you get 5 seconds per answer. Be prepared for some high speed quizzing on a wide range of hand-curated topics!
          </p>
        </div>

        <button id="play-mix-btn" class="w-full bg-[#1abc9c] text-white rounded-2xl px-6 py-4 text-xl font-semibold shadow-md hover:bg-[#16a085] transition-all">
          🎲 Random Mix
        </button>

        <div class="grid grid-cols-2 gap-4 w-full">
          <button id="practice-geo-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🌍 Geography
          </button>
          <button id="practice-geo-relaxed-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🌍 Relaxed Geography
          </button>
          <button id="practice-sci-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🔬 Science
          </button>
          <button id="practice-sci-relaxed-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🔬 Relaxed Science
          </button>
          <button id="practice-music-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🎵 Music
          </button>
          <button id="practice-music-relaxed-btn" class="bg-[#34495e] text-white rounded-2xl px-4 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
            🎵 Relaxed Music
          </button>
        </div>

        <button id="play-mix-relaxed-btn" class="w-full bg-[#34495e] text-white rounded-2xl px-6 py-3 text-lg font-semibold shadow-md hover:bg-[#2c3e50] transition-all">
          🌿 Relaxed Random Mix — No timer. Perfect for mobile users.
        </button>

        <!-- Perfect Club leaderboard -->
        <div class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl p-6">
          <p class="text-lg font-bold text-[#032922] dark:text-[#f5e5d5] mb-4">🏅 The Perfect Club</p>
          <div id="leaderboard-content">
            <p class="text-sm text-gray-500 dark:text-gray-400">Loading...</p>
          </div>
        </div>

        <div class="w-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-2xl p-6 text-center">
          <p class="text-[#032922] text-xl dark:text-[#f5e5d5] leading-relaxed">
            All sets of questions and answers have been hand compiled by a team of 2. We have tried our best to include all legitimate variations of answers, but if you stumble onto any glitches or inaccuracies please get in touch and let us know.
          </p>
        </div>

      </div>

      <!-- Name entry modal -->
      <div id="name-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-gray-900 rounded-3xl p-8 max-w-sm w-full shadow-2xl text-center border-t-8 border-[#1abc9c]">
          <p class="text-2xl font-bold text-[#032922] dark:text-[#f5e5d5] mb-2">🏆 Perfect Score!</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">Enter your name for the Perfect Club leaderboard.<br/>Max 10 characters.</p>
          <input
            id="name-input"
            type="text"
            maxlength="10"
            placeholder="Your name..."
            class="w-full bg-white dark:bg-gray-800 border-4 border-[#c9a96e] rounded-2xl px-4 py-3 text-xl font-bold text-[#032922] dark:text-[#f5e5d5] focus:outline-none focus:border-[#1abc9c] transition-colors mb-4"
            autocomplete="off"
          />
          <p id="name-error" class="text-sm text-red-500 mb-3 hidden"></p>
          <div class="flex gap-3">
            <button id="name-skip-btn" class="flex-1 bg-gray-400 text-white rounded-xl py-3 font-bold hover:bg-gray-500 transition-all">
              Skip
            </button>
            <button id="name-submit-btn" class="flex-1 bg-[#1abc9c] text-white rounded-xl py-3 font-bold hover:bg-[#16a085] transition-all">
              Submit
            </button>
          </div>
        </div>
      </div>

      <div id="active-game-container" class="hidden">
        <GameInput />

        <div class="flex justify-center mt-6">
          <button id="back-to-menu-btn" class="hidden bg-gray-600 text-white rounded-2xl px-6 py-2 font-semibold shadow-md hover:bg-gray-700 transition-all">
            ← Back to 5-5-5 Game Menu
          </button>
        </div>
      </div>

    </div>
  </Section>
</BaseLayout>

<script>
  import { createGameGame, checkAnswer, renderAnswerBox, getRandomGameSet } from "../../data/GameLogic";

  // !! Replace this with your actual Cloudflare Worker URL after deploying !!
  const WORKER_URL = "https://555-leaderboard.tamarisktaylor.workers.dev";

  const root = document.getElementById('game-root');

  if (root) {
    const geoSet = JSON.parse(root.dataset.geoSet || '[]');
    const sciSet = JSON.parse(root.dataset.sciSet || '[]');
    const musicSet = JSON.parse(root.dataset.musicSet || '[]');
    const mixSet = JSON.parse(root.dataset.mixSet || '[]');

    let activeSet: any[] = [];
    let currentRound = 0;
    let sessionHistory: any[] = [];
    let gameState = createGameGame(getRandomGameSet(mixSet, 5)[0]);
    let gameInterval: number | undefined;
    let isRelaxedMode = false;
    let modeName = "";

    const menuScreen = document.getElementById('menu-screen')!;
    const activeGameContainer = document.getElementById('active-game-container')!;
    const backToMenuBtn = document.getElementById('back-to-menu-btn')!;
    const nameModal = document.getElementById('name-modal')!;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const nameError = document.getElementById('name-error')!;
    const nameSubmitBtn = document.getElementById('name-submit-btn')!;
    const nameSkipBtn = document.getElementById('name-skip-btn')!;

    const startBtn = document.getElementById('start-game-btn');
    const nextBtn = document.getElementById('next-round-btn');
    const startScreen = document.getElementById('start-screen');

    const gameplayUI = document.getElementById('gameplay-ui');
    const input = document.querySelector('[data-Game-input]') as HTMLInputElement;
    const container = document.querySelector('[data-Game-answers-container]') as HTMLElement;
    const timerDisplay = document.querySelector('[data-timer-display]') as HTMLElement;
    const questionDisplay = document.getElementById('current-question');
    const roundIndicator = document.getElementById('round-indicator');
    const gameOverPanel = document.getElementById('game-over-panel');
    const gameOverMessage = document.getElementById('game-over-message');
    const shareBtn = document.getElementById('share-btn') as HTMLButtonElement;

    // --- LEADERBOARD FUNCTIONS ---

    const loadLeaderboard = async () => {
      const el = document.getElementById('leaderboard-content');
      if (!el) return;
      try {
        const res = await fetch(`${WORKER_URL}/scores`);
        const entries = await res.json();
        if (!entries || entries.length === 0) {
          el.innerHTML = `<p class="text-sm text-gray-500 dark:text-gray-400 italic">No perfect scores yet — be the first!</p>`;
          return;
        }
        let html = `<div class="w-full overflow-x-auto">`;
        html += `<table class="w-full text-sm text-left text-[#032922] dark:text-[#f5e5d5]">`;
        html += `<thead><tr class="border-b border-black/10 dark:border-white/10 text-xs uppercase tracking-wider opacity-60">
          <th class="pb-2 pr-4">Name</th>
          <th class="pb-2 pr-4">Mode</th>
          <th class="pb-2 pr-4">Time</th>
          <th class="pb-2">Date</th>
        </tr></thead><tbody>`;
        entries.forEach((e: any) => {
          html += `<tr class="border-b border-black/5 dark:border-white/5 last:border-0">
            <td class="py-2 pr-4 font-bold">${e.name}</td>
            <td class="py-2 pr-4">${e.gameMode}</td>
            <td class="py-2 pr-4">${e.time}s</td>
            <td class="py-2">${e.date}</td>
          </tr>`;
        });
        html += `</tbody></table></div>`;
        el.innerHTML = html;
      } catch {
        el.innerHTML = `<p class="text-sm text-gray-500 dark:text-gray-400 italic">Couldn't load leaderboard.</p>`;
      }
    };

    const submitScore = async (name: string, totalTime: number) => {
      try {
        const res = await fetch(`${WORKER_URL}/submit`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name,
            gameMode: modeName,
            time: totalTime.toFixed(2),
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          return data.error || "Submission failed";
        }
        return null; // success
      } catch {
        return "Network error — score not submitted";
      }
    };

    const showNameModal = (totalTime: number) => {
      nameModal.classList.remove('hidden');
      nameInput.value = '';
      nameError.classList.add('hidden');
      nameError.textContent = '';
      nameInput.focus();

      const handleSubmit = async () => {
        const name = nameInput.value.trim();
        if (!name) {
          nameError.textContent = "Please enter a name.";
          nameError.classList.remove('hidden');
          return;
        }
        nameSubmitBtn.textContent = "Submitting...";
        nameSubmitBtn.setAttribute('disabled', 'true');
        const error = await submitScore(name, totalTime);
        if (error) {
          nameError.textContent = error;
          nameError.classList.remove('hidden');
          nameSubmitBtn.textContent = "Submit";
          nameSubmitBtn.removeAttribute('disabled');
        } else {
          nameModal.classList.add('hidden');
          await loadLeaderboard();
        }
      };

      const handleSkip = () => {
        nameModal.classList.add('hidden');
      };

      // Replace listeners to avoid stacking them
      nameSubmitBtn.replaceWith(nameSubmitBtn.cloneNode(true));
      nameSkipBtn.replaceWith(nameSkipBtn.cloneNode(true));
      document.getElementById('name-submit-btn')!.addEventListener('click', handleSubmit);
      document.getElementById('name-skip-btn')!.addEventListener('click', handleSkip);

      nameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handleSubmit();
      }, { once: true });
    };

    // --- GAME FUNCTIONS ---

    const showMenu = () => {
      menuScreen.classList.remove('hidden');
      activeGameContainer.classList.add('hidden');
      backToMenuBtn.classList.add('hidden');
      if (gameInterval) clearInterval(gameInterval);
    };

    const initGameSession = (set: any[], name: string, isRelaxed: boolean = false) => {
      activeSet = set;
      currentRound = 0;
      sessionHistory = [];
      isRelaxedMode = isRelaxed;
      modeName = name;

      menuScreen.classList.add('hidden');
      activeGameContainer.classList.remove('hidden');

      setupRound(0);

      const titleElement = document.getElementById('game-mode-title');
      const subtitleElement = document.getElementById('game-mode-subtitle');

      if (titleElement) {
        titleElement.textContent = isRelaxed ? `5-5-5 Relaxed ${name}` : `5-5-5 ${name}`;
      }
      if (subtitleElement) {
        subtitleElement.style.fontSize = "1.125rem";
        if (isRelaxed) {
          subtitleElement.innerHTML = `${name} questions with no timer. Take your time and enjoy the game!<br><br><strong>Note:</strong> You still get 5 guesses per round, so choose wisely.`;
        } else {
          subtitleElement.innerHTML = `5 random rounds of ${name} questions. You can go back and play again for a completely new set!<br><br><strong>Top Tip:</strong> If you can't think of anything in time, the timer resets back to 5s and you only lose 1 guess!`;
        }
      }

      startScreen?.classList.remove('hidden');
      gameplayUI?.classList.add('hidden');
      backToMenuBtn.classList.remove('hidden');
    };

    const setupRound = (roundIndex: number) => {
      const topic = activeSet[roundIndex];
      if (!topic) return;

      gameState = createGameGame(topic);

      if (questionDisplay) questionDisplay.textContent = topic.label;
      if (roundIndicator) roundIndicator.textContent = `Round ${roundIndex + 1} of ${activeSet.length}`;

      input.disabled = false;
      input.value = '';
      container.innerHTML = '';
      if (timerDisplay) timerDisplay.textContent = "5";

      const timerBox = document.getElementById('timer-box');
      if (timerBox) {
        timerBox.style.borderColor = '';
        timerBox.style.color = '';
      }

      gameOverPanel?.classList.add('hidden');
      if (gameOverPanel) gameOverPanel.style.display = 'none';
      nextBtn?.classList.add('hidden');
      shareBtn?.classList.add('hidden');
    };

    const startCurrentRound = () => {
      gameState.isStarted = true;
      gameState.startTime = performance.now();

      startScreen?.classList.add('hidden');
      gameplayUI?.classList.remove('hidden');
      backToMenuBtn.classList.add('hidden');
      input.focus();

      const timerBox = document.getElementById('timer-box');
      if (timerBox) {
        timerBox.style.display = isRelaxedMode ? 'none' : '';
      }

      if (isRelaxedMode) return;

      let lastTick = performance.now();
      gameInterval = window.setInterval(() => {
        const now = performance.now();
        const delta = (now - lastTick) / 1000;
        lastTick = now;
        gameState.timeLeftSeconds -= delta;
        if (timerDisplay) {
          timerDisplay.textContent = Math.ceil(Math.max(0, gameState.timeLeftSeconds)).toString();
        }

        if (gameState.timeLeftSeconds <= 0) {
          const timerBox = document.getElementById('timer-box');
          if (timerBox) {
            timerBox.style.borderColor = 'rgba(231, 76, 60, 0.8)';
            timerBox.style.color = 'rgba(231, 76, 60, 0.8)';
          }

          const penaltyHistory = [...gameState.guessHistory, { word: '', correct: false }];
          gameState = { ...gameState, guessHistory: penaltyHistory, timeLeftSeconds: 5 };

          renderAnswerBox('', false, input, container);
          if (timerDisplay) timerDisplay.textContent = "5";

          setTimeout(() => {
            if (timerBox) {
              timerBox.style.borderColor = '';
              timerBox.style.color = '';
            }
          }, 300);

          if (penaltyHistory.length >= 5) {
            finishRound();
          }
        }
      }, 10);
    };

    const finishRound = () => {
      if (gameInterval) clearInterval(gameInterval);
      gameState.endTime = performance.now();
      gameState.isGameOver = true;
      input.disabled = true;

      sessionHistory.push({...gameState});

      const won = gameState.correctAnswers.length === 5;
      gameOverPanel?.classList.remove('hidden');
      if (gameOverPanel) gameOverPanel.style.display = 'flex';

      if (gameOverMessage) {
        const dur = ((gameState.endTime - gameState.startTime!) / 1000).toFixed(2);
        gameOverMessage.textContent = won ? `Perfect! (${dur}s)` : `Finished: ${gameState.correctAnswers.length}/5`;
      }

      if (currentRound < activeSet.length - 1) {
        nextBtn?.classList.remove('hidden');
      } else {
        backToMenuBtn.classList.remove('hidden');

        if (gameOverMessage) {
          const totalScore = sessionHistory.reduce((acc, curr) => acc + curr.correctAnswers.length, 0);
          const totalTime = sessionHistory.reduce((acc, curr) => acc + ((curr.endTime! - curr.startTime!) / 1000), 0);

          let html = `<div class="flex flex-col items-center gap-2 w-full">`;
          html += `<span class="text-2xl font-bold text-[#032922] dark:text-[#f5e5d5]">Game Complete!</span>`;
          html += `<span class="text-lg font-semibold text-gray-700 dark:text-gray-300">Total Score: ${totalScore}/${activeSet.length * 5} | Total Time: ${totalTime.toFixed(2)}s</span>`;
          html += `<div class="text-sm mt-3 flex flex-col gap-2 w-full max-w-sm text-left bg-black/5 dark:bg-white/5 p-4 rounded-xl text-[#032922] dark:text-[#f5e5d5]">`;

          sessionHistory.forEach((round, i) => {
            const rScore = round.correctAnswers.length;
            const rTime = ((round.endTime! - round.startTime!) / 1000).toFixed(2);
            html += `
              <div class="flex justify-between items-center border-b border-gray-300 dark:border-gray-600 pb-1 last:border-0 last:pb-0">
                <span class="truncate pr-2 font-medium" title="${round.topic.category}">Round ${i + 1}: ${round.topic.category}</span>
                <span class="font-bold whitespace-nowrap">${rScore}/5 <span class="text-xs font-normal opacity-75">(${rTime}s)</span></span>
              </div>`;
          });

          html += `</div></div>`;
          gameOverMessage.innerHTML = html;

          // Show name modal only for timed perfect scores
          if (!isRelaxedMode && totalScore === activeSet.length * 5) {
            showNameModal(totalTime);
          }
        }

        shareBtn?.classList.add('hidden');
      }
    };

    // Event Listeners
    document.getElementById('play-mix-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(mixSet, 5), "Random Mix", false));
    document.getElementById('play-mix-relaxed-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(mixSet, 5), "Random Mix", true));
    document.getElementById('practice-geo-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(geoSet, 5), "Geography", false));
    document.getElementById('practice-geo-relaxed-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(geoSet, 5), "Geography", true));
    document.getElementById('practice-sci-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(sciSet, 5), "Science", false));
    document.getElementById('practice-sci-relaxed-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(sciSet, 5), "Science", true));
    document.getElementById('practice-music-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(musicSet, 5), "Music", false));
    document.getElementById('practice-music-relaxed-btn')?.addEventListener('click', () => initGameSession(getRandomGameSet(musicSet, 5), "Music", true));
    backToMenuBtn.addEventListener('click', showMenu);

    startBtn?.addEventListener('click', startCurrentRound);

    nextBtn?.addEventListener('click', () => {
      currentRound++;
      setupRound(currentRound);
      startCurrentRound();
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = input.value.trim();
        if (!val || gameState.isGameOver) return;
        const historyBefore = gameState.guessHistory.length;
        gameState = checkAnswer(gameState, val);
        input.value = '';
        if (gameState.guessHistory.length > historyBefore) {
          const last = gameState.guessHistory[gameState.guessHistory.length - 1];
          renderAnswerBox(last.word, last.correct, input, container);
          if (!isRelaxedMode) {
            gameState.timeLeftSeconds = 5;
            if (timerDisplay) timerDisplay.textContent = "5";
          }
          if (gameState.isGameOver) finishRound();
        }
      }
    });

    // Load leaderboard on page load
    loadLeaderboard();
  }
</script>